# Copia este archivo a `.env` (NO se sube al repo) y reinicia `npm run dev`.

# Leaflet: clave gratuita de tiles CARTO (https://carto.com/basemaps/apikey/).
# Si la dejas vacía, Leaflet usa los tiles públicos de OpenStreetMap como respaldo.
VITE_CARTO_KEY=

# Google Maps: clave de "Maps JavaScript API".
# IMPORTANTE: restríngela por HTTP referrer (localhost:5173 y tu dominio) en Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Opcional: ID de mapa propio (Google Cloud > Map Management). Si no, usa DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=
